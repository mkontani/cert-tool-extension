{
    "manifest_version": 3,
    "name": "Cert Tool",
    "version": "1.1.0",
    "description": "Generate keys and CSRs, inspect certificate chains, and lint certificates against CA/B Forum rules, all locally in your browser.",
    "action": {
        "default_popup": "index.html",
        "default_title": "Cert Tool",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "permissions": [
        "downloads",
        "activeTab",
        "scripting",
        "contextMenus"
    ]
}