{
    "manifest_version": 3,
    "name": "Cert Tool",
    "version": "1.0.1",
    "description": "A comprehensive tool for certificates: Key Pair Generation, CSR Generation, Public Key Derivation, and Inspection.",
    "action": {
        "default_popup": "index.html",
        "default_title": "Cert Tool",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "downloads"
    ]
}